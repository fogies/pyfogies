# Config for claude-sync tasks.
# See https://github.com/tawanorg/claude-sync

# Profile in the AWS config, for an IAM user that can use the buckets.
aws_profile = "..."

# S3 bucket that claude-sync syncs to.
bucket = "..."
# S3 bucket for the record of deleted sessions, which claude-sync does not use.
deletions_bucket = "..."
region = "..."

# What to sync: "sessions" or "full".
scope = "sessions"

# Encryption key.
# claude-sync.configure will create, so that all machines have the same key.
# age_key = "AGE-SECRET-KEY-1..."
