# pyfogies test configuration
#
# Copy this file to secrets/pyfogies-tests.toml and fill in the values.
# The secrets/ directory is not versioned.

[aws]
# AWS profile name to use for tests (as defined in secrets/aws.toml).
profile = "pyfogies-test"
# AWS region in which to create all test resources.
region = "us-west-2"

# Optional: provide a domain to enable DNS-validated certificate tests.
# A Route 53 hosted zone for this domain must already exist (apply terraform/hosted_zone once).
# [domain]
# zone_name = "example.com"

